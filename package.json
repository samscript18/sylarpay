{
  "name": "skylarpay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:test": "cargo test --manifest-path contracts/username-registry/Cargo.toml",
    "contract:build": "cargo build --manifest-path contracts/username-registry/Cargo.toml --target wasm32v1-none --release",
    "contract:deploy": "tsx scripts/deploy.ts",
    "test:live": "tsx scripts/live-test.ts",
    "test:e2e": "playwright test",
    "contract:initialize": "tsx scripts/initialize.ts",
    "demo:seed": "tsx scripts/seed.ts",
    "format": "prettier --write app components lib server scripts tests docs README.md *.ts *.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
